{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "API de dados da Ziala",
  "colors": {
    "primary": "#12615C",
    "light": "#47BFB3",
    "dark": "#12615C"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://ziala.com.br"
  },
  "fonts": {
    "family": "Geist"
  },
  "navigation": {
    "languages": [
      {
        "language": "pt-BR",
        "tabs": [
          {
            "tab": "Documentação",
            "groups": [
              {
                "group": "Começar",
                "pages": [
                  "index",
                  "inicio-rapido",
                  "autenticacao"
                ]
              },
              {
                "group": "Conceitos",
                "pages": [
                  "conceitos/modelo-de-dados",
                  "conceitos/paginacao",
                  "conceitos/sincronizacao-incremental",
                  "conceitos/exclusoes",
                  "conceitos/limites",
                  "conceitos/erros",
                  "conceitos/versionamento"
                ]
              },
              {
                "group": "Guias de integração",
                "pages": [
                  "guias/plataformas-de-dados",
                  "guias/airbyte",
                  "guias/power-bi",
                  "guias/data-warehouse",
                  "guias/codigo-proprio"
                ]
              },
              {
                "group": "Recursos",
                "pages": [
                  "changelog"
                ]
              }
            ]
          },
          {
            "tab": "Referência da API",
            "groups": [
              {
                "group": "Visão geral",
                "pages": [
                  "api-reference/introducao"
                ]
              },
              {
                "group": "Endpoints",
                "openapi": "https://api.ziala.com.br/v1/openapi.json"
              }
            ]
          }
        ]
      }
    ]
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "python",
        "javascript"
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Site da Ziala",
        "href": "https://ziala.com.br"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "redirects": [
    {
      "source": "/paginacao-e-atraso",
      "destination": "/conceitos/paginacao"
    },
    {
      "source": "/receitas-incrementais",
      "destination": "/conceitos/sincronizacao-incremental"
    },
    {
      "source": "/exclusoes-e-lgpd",
      "destination": "/conceitos/exclusoes"
    },
    {
      "source": "/limites",
      "destination": "/conceitos/limites"
    },
    {
      "source": "/erros",
      "destination": "/conceitos/erros"
    },
    {
      "source": "/versionamento",
      "destination": "/conceitos/versionamento"
    },
    {
      "source": "/objetos",
      "destination": "/conceitos/modelo-de-dados"
    },
    {
      "source": "/guias/rest-curl",
      "destination": "/guias/codigo-proprio"
    },
    {
      "source": "/guias/plataforma-de-dados",
      "destination": "/guias/plataformas-de-dados"
    }
  ]
}
