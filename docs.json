{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "API de dados da Ziala",
  "colors": {
    "primary": "#12615C",
    "light": "#47BFB3",
    "dark": "#12615C"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://ziala.com.br"
  },
  "fonts": {
    "family": "Geist"
  },
  "navigation": {
    "languages": [
      {
        "language": "pt-BR",
        "tabs": [
          {
            "tab": "Guia",
            "groups": [
              {
                "group": "Começo",
                "pages": [
                  "index",
                  "autenticacao",
                  "objetos"
                ]
              },
              {
                "group": "Buscar só o que mudou",
                "pages": [
                  "paginacao-e-atraso",
                  "receitas-incrementais",
                  "exclusoes-e-lgpd"
                ]
              },
              {
                "group": "Regras",
                "pages": [
                  "limites",
                  "erros",
                  "versionamento",
                  "changelog"
                ]
              },
              {
                "group": "Guias",
                "pages": [
                  "guias/rest-curl",
                  "guias/plataforma-de-dados",
                  "guias/airbyte",
                  "guias/power-bi"
                ]
              }
            ]
          },
          {
            "tab": "Referência",
            "groups": [
              {
                "group": "Endpoints",
                "openapi": "https://api.ziala.com.br/v1/openapi.json"
              }
            ]
          }
        ]
      }
    ]
  },
  "api": {
    "playground": {
      "display": "interactive"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Site da Ziala",
        "href": "https://ziala.com.br"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  }
}
